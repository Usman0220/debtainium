#!/bin/sh
set -e

case "$1" in
    configure)
        if command -v update-desktop-database >/dev/null 2>&1; then
            update-desktop-database -q /usr/share/applications || true
        fi

        if command -v gtk-update-icon-cache >/dev/null 2>&1; then
            gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
        fi

        if command -v appstreamcli >/dev/null 2>&1; then
            appstreamcli refresh --source=os --no-net --quiet >/dev/null 2>&1 || true
        fi

        echo "Debtainium 1.1.0 installed successfully."
        echo "Tip: Run 'debtainium gui' to launch the GUI or 'debtainium --help' for CLI."
        echo "To check for updates in the background (every 6 hours):"
        echo "  systemctl --user enable --now debtainium-notify.timer"
        echo "To install flagged updates automatically (daily, needs a polkit rule):"
        echo "  see /usr/share/doc/debtainium/examples/49-debtainium-autoupdate.rules"
        echo "  systemctl --user enable --now debtainium-autoupdate.timer"
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        ;;
esac

exit 0
